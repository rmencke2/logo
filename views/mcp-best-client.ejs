<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <title><%= pageTitle %> - Influzer.ai</title>
    <meta name="description" content="<%= metaDescription %>" />
    <link rel="canonical" href="<%= canonicalUrl %>" />
    <%- include('partials/seo-social', {
      ogTitle: pageTitle + ' - Influzer.ai',
      ogDescription: metaDescription,
      ogUrl: canonicalUrl,
      ogImage: typeof ogImage !== 'undefined' ? ogImage : undefined,
    }) %>
    <% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
      <script type="application/ld+json">
        <%- JSON.stringify(jsonLd) %>
      </script>
    <% } %>
    <%- include('partials/favicon-links') %>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/site-header.css" />
    <link rel="stylesheet" href="/css/mcp-directory.css" />
    <link rel="stylesheet" href="/css/seo-content.css" />
    <style>
      .mcp-page { max-width: 1120px; margin: 0 auto; padding: 48px 20px 80px; }
      .mcp-back { font-family: var(--font-ui); margin-bottom: 20px; display: inline-block; color: var(--color-charcoal); text-decoration: none; }
      .mcp-back:hover { color: var(--color-terracotta); }
      .mcp-topic-section { margin: 32px 0; }
      .mcp-topic-section h2 { margin: 0 0 12px; font-size: 1.2rem; }
      .mcp-topic-section ol, .mcp-topic-section ul { margin: 0; padding-left: 1.25rem; line-height: 1.7; color: var(--color-charcoal-light); }
      .mcp-topic-section li { margin-bottom: 8px; }
      .mcp-topic-section .mcp-stack-blurb { margin: 0 0 16px; color: var(--color-charcoal-light); line-height: 1.65; }
      .mcp-surfaces { display: grid; gap: 12px; grid-template-columns: 1fr; margin: 20px 0 8px; }
      @media (min-width: 800px) { .mcp-surfaces { grid-template-columns: repeat(3, 1fr); } }
      .mcp-surface {
        padding: 16px 18px; border-radius: 14px; border: 1px solid var(--color-border);
        background: var(--color-paper);
      }
      .mcp-surface h2 { margin: 0 0 6px; font-size: 1rem; }
      .mcp-surface .mcp-surface-meta {
        font-family: var(--font-ui); font-size: .75rem; font-weight: 600;
        color: var(--color-terracotta); margin-bottom: 8px; display: block;
      }
      .mcp-surface p { margin: 0; font-size: .9rem; line-height: 1.55; color: var(--color-charcoal-light); }
      .mcp-search-cta {
        margin: 24px 0; padding: 14px 18px; border-radius: 14px;
        background: var(--color-cream-dark); border: 1px solid var(--color-border);
        font-size: .95rem;
      }
      .mcp-search-cta a { color: var(--color-terracotta); font-weight: 600; }
      .mcp-topic-related { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
      .mcp-topic-related a {
        font-family: var(--font-ui); font-size: .85rem; padding: 8px 14px; border-radius: 999px;
        text-decoration: none; border: 1px solid var(--color-border); color: var(--color-charcoal);
      }
      .mcp-topic-related a:hover { border-color: var(--color-terracotta); color: var(--color-terracotta); }
    </style>
  </head>
  <body>
    <%- include('partials/site-header', { navPath: '/mcp' }) %>
    <script src="/js/site-header.js" defer></script>

    <main class="mcp-page">
      <a class="mcp-back" href="/mcp/best">← Best MCP by client</a>

      <header class="mcp-header">
        <p class="mcp-kicker">Best MCP servers for <%= client.shortTitle %></p>
        <h1><%= client.title %></h1>
        <p class="mcp-lead"><%= client.intro %></p>
      </header>

      <div class="mcp-surfaces">
        <% client.surfaces.forEach(function(surface) { %>
          <article class="mcp-surface">
            <h2><%= surface.name %></h2>
            <span class="mcp-surface-meta"><%= surface.transport %></span>
            <p><%= surface.blurb %></p>
          </article>
        <% }); %>
      </div>

      <p class="mcp-search-cta">
        <%= featuredServers.length %> featured servers below, grouped by job.
        <a href="<%= client.setupHref %>"><%= client.setupLabel %> →</a>
        · <a href="/mcp">Top 100 directory</a>
      </p>

      <% stacks.forEach(function(stack) { %>
        <section class="mcp-topic-section">
          <h2><%= stack.title %></h2>
          <p class="mcp-stack-blurb"><%= stack.blurb %></p>
          <div class="mcp-grid">
            <% stack.servers.forEach(function(server) { %>
              <%- include('partials/mcp-server-card', { server: server }) %>
            <% }); %>
          </div>
        </section>
      <% }); %>

      <section class="mcp-topic-section">
        <h2>Setup checklist</h2>
        <ol>
          <% client.checklist.forEach(function(step) { %>
            <li><%- step %></li>
          <% }); %>
        </ol>
      </section>

      <section class="mcp-topic-section">
        <h2>How to choose for <%= client.shortTitle %></h2>
        <ul>
          <% client.chooseTips.forEach(function(tip) { %>
            <li><%- tip %></li>
          <% }); %>
        </ul>
      </section>

      <% if (relatedTopics && relatedTopics.length) { %>
        <section class="mcp-topic-section">
          <h2>Related topic guides</h2>
          <div class="mcp-topic-related">
            <% relatedTopics.forEach(function(rt) { %>
              <a href="/mcp/topics/<%= rt.slug %>"><%= rt.shortTitle %></a>
            <% }); %>
          </div>
        </section>
      <% } %>

      <% if (relatedComparisons && relatedComparisons.length) { %>
        <section class="mcp-topic-section">
          <h2>Related comparisons</h2>
          <div class="mcp-topic-related">
            <% relatedComparisons.forEach(function(rc) { %>
              <a href="/mcp/compare/<%= rc.slug %>"><%= rc.shortTitle %></a>
            <% }); %>
          </div>
        </section>
      <% } %>

      <%- include('partials/seo-faq-crosslinks', { seoContent: seoContent }) %>
    </main>
  </body>
</html>
