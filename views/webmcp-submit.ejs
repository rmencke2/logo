<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <meta name="description" content="<%= description %>" />
    <link rel="canonical" href="<%= canonicalUrl %>" />
    <%- include('partials/seo-social', { ogTitle: title, ogDescription: description, ogUrl: canonicalUrl }) %>
    <%- include('partials/favicon-links') %>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/home.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/css/webmcp-directory.css?v=<%= assetVersion %>" />
  </head>
  <body class="registry-page webmcp-page">
    <%- include('partials/home-header') %>
    <main class="dir-shell webmcp-scan" style="padding:2rem 1rem 3rem;max-width:720px;">
      <p class="webmcp-note"><a href="/webmcp">← WebMCP Directory</a></p>
      <header class="webmcp-scan__hero">
        <p class="dir-hero__eyebrow">Scan-gated listing</p>
        <h1>Add your WebMCP site</h1>
        <p class="webmcp-prose">
          We scan your public pages for <code>document.modelContext</code> tools, score Agent Readiness (R0–R5), and list verified sites in the Influzer directory.
          Your email is required so we can share the report — and subscribe you to the Influzer newsletter (unsubscribe anytime).
        </p>
      </header>

      <form id="webmcpScanForm" class="webmcp-scan__form" novalidate>
        <label>
          Your email
          <input id="scanEmail" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
        </label>
        <label>
          Your site URL
          <input id="scanUrl" name="url" type="text" inputmode="url" required placeholder="www.example.com or https://www.example.com" />
        </label>
        <label>
          Relationship
          <select id="scanRelationship" name="relationship">
            <option value="owner" selected>Site owner</option>
            <option value="developer">Developer</option>
            <option value="user">User</option>
            <option value="researcher">Researcher</option>
          </select>
        </label>
        <label class="webmcp-scan__check">
          <input id="scanNewsletter" name="newsletter" type="checkbox" checked />
          <span>Email me the scan report and subscribe me to the Influzer newsletter (community updates, new WebMCP/MCP listings). Unsubscribe anytime.</span>
        </label>
        <div class="webmcp-scan__hp" aria-hidden="true">
          <label>Company website<input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <button class="webmcp-btn webmcp-btn--primary" id="scanSubmitBtn" type="submit">Request listing / start scan</button>
        <p class="webmcp-note" id="scanFormNote">Usually finishes in under 60 seconds. We do not execute third-party act/transact tools.</p>
        <p class="webmcp-scan__error" id="scanFormError" hidden></p>
      </form>

      <section class="webmcp-scan__live" id="scanLive" hidden>
        <div class="webmcp-scan__live-top">
          <div>
            <p class="webmcp-scan__live-host" id="scanLiveHost">—</p>
            <p class="webmcp-scan__live-msg" id="scanLiveMsg">Starting…</p>
          </div>
          <span class="webmcp-scan__timer" id="scanLiveTimer">0s</span>
        </div>
        <div class="webmcp-scan__progress">
          <div class="webmcp-scan__progress-label">
            <span>Scanning pages</span>
            <span id="scanLivePages">0 / 6</span>
          </div>
          <div class="webmcp-scan__bar"><span id="scanLiveBar"></span></div>
        </div>
        <div class="webmcp-scan__stats">
          <div><b id="scanStatTools">0</b><span>Tools detected</span></div>
          <div><b id="scanStatPages">0</b><span>Pages scanned</span></div>
          <div><b id="scanStatCrashes">0</b><span>Crashes</span></div>
        </div>
        <p class="webmcp-note">We’ll keep your email on the Influzer newsletter so you get directory and community updates.</p>
      </section>

      <section class="webmcp-scan__report" id="scanReport" hidden>
        <div class="webmcp-scan__grade">
          <div class="webmcp-scan__grade-mark" id="scanGrade">—</div>
          <div>
            <p class="webmcp-scan__grade-label" id="scanGradeLabel">—</p>
            <p class="webmcp-note" id="scanGradeMeta">—</p>
          </div>
        </div>
        <div class="webmcp-scan__banner" id="scanBanner"></div>
        <ul class="webmcp-scan__findings" id="scanFindings"></ul>
        <div class="webmcp-scan__tools" id="scanTools"></div>
        <div class="webmcp-cta-row" id="scanReportActions"></div>
        <section class="webmcp-scan__journeys" id="scanJourneys" hidden>
          <h2>Suggested journeys</h2>
          <p class="webmcp-note">Start with one of these intents when testing with an agent.</p>
          <ul id="scanJourneyList"></ul>
        </section>
      </section>
    </main>
    <%- include('partials/registry-footer') %>
    <script>
      window.__WEBMCP_SCAN_INITIAL__ = <%= JSON.stringify(initialScanId || null) %>;
    </script>
    <script src="/js/site-auth.js?v=<%= assetVersion %>" defer></script>
    <script src="/js/webmcp-scan.js?v=<%= assetVersion %>" defer></script>
    <%- include('partials/influzer-webmcp-script') %>
  </body>
</html>
