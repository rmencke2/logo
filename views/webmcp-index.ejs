<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <title><%= title %></title>
    <meta name="description" content="<%= description %>" />
    <link rel="canonical" href="<%= canonicalUrl %>" />
    <%- include('partials/seo-social', { ogTitle: title, ogDescription: description, ogUrl: canonicalUrl }) %>
    <%- include('partials/favicon-links') %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/home.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/css/mcp-directory-page.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/css/webmcp-directory.css?v=<%= assetVersion %>" />
  </head>
  <body class="registry-page webmcp-page">
    <%- include('partials/home-header') %>

    <header class="dir-hero">
      <div class="dir-hero__inner">
        <p class="dir-hero__eyebrow">The agent-ready web</p>
        <h1 class="dir-hero__title">Find websites with tools for AI agents</h1>
        <p class="dir-hero__lead">Browse websites that expose structured WebMCP tools for search, navigation, forms, carts, bookings, and more.</p>
        <p class="webmcp-diff"><a href="/webmcp/about">WebMCP is not an MCP server. Learn the difference →</a></p>
        <div class="webmcp-metrics" aria-label="Directory stats">
          <span><b><%= stats.site_count.toLocaleString() %></b> websites</span>
          <span><b><%= stats.tool_count.toLocaleString() %></b> tools</span>
          <span><b><%= stats.live_count.toLocaleString() %></b> live</span>
          <span><b><%= stats.category_count.toLocaleString() %></b> categories</span>
          <% if (stats.refreshed_at) { %><span>Updated <%= String(stats.refreshed_at).slice(0, 10) %></span><% } %>
        </div>
        <div class="webmcp-cta-row">
          <a class="webmcp-btn webmcp-btn--primary" href="/webmcp/submit">Scan your website</a>
          <a class="webmcp-btn webmcp-btn--ghost" href="/webmcp/tools">Browse tools</a>
          <a class="webmcp-btn webmcp-btn--ghost" href="/insights/what-is-webmcp-agents-navigate-websites">What is WebMCP?</a>
        </div>
      </div>
    </header>

    <main class="dir-shell" id="main">
      <form class="webmcp-filters" method="get" action="/webmcp" role="search">
        <label>Search
          <input type="search" name="q" value="<%= filters.q || '' %>" placeholder="Search sites, tools, or capabilities…" />
        </label>
        <label>Type
          <select name="type">
            <option value="">All</option>
            <option value="live" <%= filters.type === 'live' ? 'selected' : '' %>>Live</option>
            <option value="demo" <%= filters.type === 'demo' ? 'selected' : '' %>>Demo</option>
          </select>
        </label>
        <label>Category
          <select name="category">
            <option value="">All</option>
            <% categories.forEach(function(c) { %>
              <option value="<%= c.slug %>" <%= filters.category === c.slug ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </label>
        <label>Tool kind
          <select name="kind">
            <option value="">All</option>
            <option value="answer" <%= filters.kind === 'answer' ? 'selected' : '' %>>Answer</option>
            <option value="act" <%= filters.kind === 'act' ? 'selected' : '' %>>Act</option>
            <option value="transact" <%= filters.kind === 'transact' ? 'selected' : '' %>>Transact</option>
          </select>
        </label>
        <label>Sort
          <select name="sort">
            <option value="relevance" <%= !filters.sort || filters.sort === 'relevance' ? 'selected' : '' %>>Relevance</option>
            <option value="tools" <%= filters.sort === 'tools' ? 'selected' : '' %>>Most tools</option>
            <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest</option>
            <option value="recent" <%= filters.sort === 'recent' ? 'selected' : '' %>>Recently seen</option>
          </select>
        </label>
        <button class="webmcp-btn webmcp-btn--primary" type="submit">Apply</button>
      </form>

      <p class="webmcp-note"><%= total.toLocaleString() %> result<%= total === 1 ? '' : 's' %> · Verification means Influzer observed tools — seed imports start as unverified.</p>

      <% if (!sites.length) { %>
        <div class="webmcp-empty">
          <p>No matches. Try clearing filters or <a href="/webmcp/submit">submit a missing site</a>.</p>
        </div>
      <% } else { %>
        <div class="webmcp-grid">
          <% sites.forEach(function(site) { %>
            <%- include('partials/webmcp-site-card', { site }) %>
          <% }) %>
        </div>
      <% } %>

      <% if (pages > 1) { %>
        <nav class="webmcp-pager" aria-label="Pagination">
          <% if (page > 1) { %>
            <a href="?<%= new URLSearchParams({ ...filters, page: String(page - 1) }).toString() %>">← Previous</a>
          <% } %>
          <span>Page <%= page %> of <%= pages %></span>
          <% if (page < pages) { %>
            <a href="?<%= new URLSearchParams({ ...filters, page: String(page + 1) }).toString() %>">Next →</a>
          <% } %>
        </nav>
      <% } %>
    </main>
    <%- include('partials/registry-footer') %>
    <script src="/js/site-auth.js?v=<%= assetVersion %>" defer></script>
  </body>
</html>
