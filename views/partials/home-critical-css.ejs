<%# Above-the-fold only — keeps mobile FCP/LCP from waiting on home.css (31KB). %>
<style>
.home-page{
  --hp-bg:#fafaf8;--hp-bg2:#f2f1ec;--hp-card:#fff;--hp-surface:#f4f3ee;--hp-surface2:#f0efe9;
  --hp-border:#e6e4dd;--hp-border2:#dddbd3;--hp-text:#16181d;--hp-muted:#4b4e57;--hp-muted2:#6d707a;
  --hp-faint:#9a9ca3;--hp-navbg:rgba(250,250,248,.92);--hp-accent:#4f46e5;--hp-accent-hover:#4338ca;
  --hp-accent-deep:#312e81;--hp-accent-tint:#eef2ff;--hp-accent-fg:#4338ca;--hp-link:#4f46e5;
  --hp-font:'Bricolage Grotesque','Segoe UI',system-ui,-apple-system,sans-serif;
  --hp-mono:'Martian Mono','SF Mono',ui-monospace,Menlo,monospace;
  margin:0;min-height:100vh;display:flex;flex-direction:column;background:var(--hp-bg);
  font-family:var(--hp-font);color:var(--hp-text);-webkit-font-smoothing:antialiased;
}
.home-page.dark{
  --hp-bg:#0f1115;--hp-bg2:#14171d;--hp-card:#1a1d24;--hp-surface:#14171d;--hp-surface2:#262a33;
  --hp-border:#2a2e37;--hp-border2:#363b45;--hp-text:#f1f2f4;--hp-muted:#b0b4bd;--hp-muted2:#9599a2;
  --hp-faint:#70747d;--hp-navbg:rgba(15,17,21,.9);
}
.home-page a{color:var(--hp-link);text-decoration:none}
.home-page .skip-link{position:absolute;left:-9999px}
.home-nav{position:sticky;top:0;z-index:10;background:var(--hp-navbg);border-bottom:1px solid var(--hp-border)}
.home-nav__inner{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:14px 32px;gap:16px}
.home-nav__left{display:flex;align-items:center;gap:34px;min-width:0}
.home-nav__brand{font-weight:700;font-size:18px;letter-spacing:-.02em;color:var(--hp-text);text-decoration:none;white-space:nowrap}
.home-nav__brand-dot{color:var(--hp-accent)}
.home-nav__links{display:flex;gap:4px;font-size:13.5px;color:var(--hp-muted);font-weight:500}
.home-nav__link{padding:6px 10px;border-radius:6px;color:var(--hp-muted);text-decoration:none}
.home-nav__right{display:flex;align-items:center;gap:16px;flex-shrink:0}
.home-nav__theme{font-size:15px;line-height:1;color:var(--hp-muted);background:none;border:none;padding:4px 6px;cursor:pointer}
.home-nav__login,.home-nav__subscribe{font-size:13.5px;color:var(--hp-muted);font-weight:500;text-decoration:none}
.home-nav__submit{background:var(--hp-accent);color:#fff!important;font-size:13px;font-weight:600;padding:9px 14px;border-radius:7px;text-decoration:none;white-space:nowrap}
.home-nav__menu-btn{display:none;background:none;border:1px solid var(--hp-border);border-radius:7px;padding:8px 10px;cursor:pointer;color:var(--hp-text)}
.home-nav__menu-bars{display:flex;flex-direction:column;gap:3px}
.home-nav__menu-bars span{display:block;width:16px;height:2px;background:currentColor}
.site-header-lang-hidden{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;border:0!important}
.mcp-milestone{min-height:140px;background:var(--hp-accent-tint);border-bottom:1px solid var(--hp-border);color:var(--hp-text)}
.mcp-milestone__inner{max-width:1200px;margin:0 auto;padding:20px 32px;display:grid;gap:14px}
.mcp-milestone__eyebrow{margin:0;font-family:var(--hp-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--hp-accent-fg)}
.mcp-milestone__headline{margin:4px 0 0;font-size:1.25rem;font-weight:700;line-height:1.2}
.mcp-milestone__blurb{margin:8px 0 0;color:var(--hp-muted);font-size:14px;line-height:1.5}
.mcp-milestone__actions{display:flex;flex-wrap:wrap;gap:8px}
.mcp-milestone__btn{display:inline-flex;align-items:center;min-height:40px;padding:0 14px;border-radius:8px;border:1px solid var(--hp-border2);background:var(--hp-card);color:var(--hp-text);font-weight:600;font-size:13.5px;text-decoration:none}
.mcp-milestone__btn--primary{background:var(--hp-accent);border-color:var(--hp-accent);color:#fff}
.home-hero{background:linear-gradient(180deg,var(--hp-bg) 0%,var(--hp-bg2) 100%);border-bottom:1px solid var(--hp-border)}
.home-hero__inner{max-width:1200px;margin:0 auto;padding:76px 32px 56px;text-align:center}
.home-hero__eyebrow{margin:0 0 16px;font-family:var(--hp-mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--hp-accent)}
.home-hero__title{margin:0 0 16px;font-size:clamp(2rem,5vw,50px);line-height:1.06;letter-spacing:-.03em;font-weight:700;color:var(--hp-text);min-height:2.2em}
.home-hero__lead{margin:0 auto 24px;max-width:42rem;font-size:1.05rem;line-height:1.55;color:var(--hp-muted)}
.home-hero__cta{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin:0 0 28px}
.home-hero__cta-btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 18px;border-radius:10px;border:1.5px solid var(--hp-border2);background:var(--hp-card);color:var(--hp-text);font-family:var(--hp-font);font-size:14.5px;font-weight:600;text-decoration:none}
.home-hero__cta-btn--primary{background:var(--hp-text);border-color:var(--hp-text);color:var(--hp-card)}
.home-hero__cta-btn--ghost{background:transparent}
.home-hero__stats{display:flex;gap:12px 22px;justify-content:center;margin-top:8px;font-family:var(--hp-mono);font-size:13px;color:var(--hp-muted);flex-wrap:wrap}
.home-hero__stats b{color:var(--hp-text);font-size:17px}
.home-hero__stat{display:inline-flex;gap:6px;align-items:baseline}
@media (max-width:900px){
  .home-nav__links,.home-nav__subscribe{display:none}
  .home-nav__menu-btn{display:inline-flex}
  .home-nav__inner{padding:12px 20px}
  .home-hero__inner{padding:48px 20px 40px}
  .mcp-milestone__inner{padding:20px}
}
</style>
