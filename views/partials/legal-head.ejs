<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <title><%= pageTitle %> — Influzer.ai</title>
    <meta name="description" content="<%= metaDescription %>" />
    <link rel="canonical" href="<%= canonicalUrl %>" />
    <%- include('seo-social', {
      ogTitle: pageTitle + ' — Influzer.ai',
      ogDescription: metaDescription,
      ogUrl: canonicalUrl,
    }) %>
    <%- include('favicon-links') %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/home.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/css/mcp-setup-page.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/css/legal.css?v=<%= assetVersion %>" />
    <% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
      <script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>
    <% } %>
  </head>
  <body class="registry-page">
    <a class="skip-link" href="#main">Skip to main content</a>
    <%- include('home-header') %>
    <main class="setup-shell legal-page" id="main">
