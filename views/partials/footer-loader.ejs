<!-- Footer -->
<div id="footer-container"></div>
<script nonce="<%= cspNonce %>">
  // Load footer
  function loadFooter() {
    const footerContainer = document.getElementById('footer-container');
    if (!footerContainer) return;
    fetch('/footer.html')
      .then(response => {
        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        return response.text();
      })
      .then(html => {
        footerContainer.innerHTML = html;
        const footerSelector = footerContainer.querySelector('#footerLanguageSelector');
        if (!footerSelector || footerSelector.dataset.bound === '1') return;
        footerSelector.dataset.bound = '1';
        const mainSelector = document.getElementById('languageSelector');
        if (mainSelector) {
          footerSelector.value = mainSelector.value || 'en';
          mainSelector.addEventListener('change', () => {
            footerSelector.value = mainSelector.value;
          });
        }
        footerSelector.addEventListener('change', () => {
          if (mainSelector) mainSelector.value = footerSelector.value;
          if (window.i18n && typeof window.i18n.setLanguage === 'function') {
            window.i18n.setLanguage(footerSelector.value);
          } else {
            window.location.href = '/?lang=' + encodeURIComponent(footerSelector.value);
          }
        });
      })
      .catch(err => console.error('Error loading footer:', err));
  }

  // Load footer when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadFooter);
  } else {
    loadFooter();
  }
</script>
