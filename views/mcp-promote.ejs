<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <title><%= pageTitle %> — Influzer.ai</title>
    <meta name="description" content="<%= metaDescription %>" />
    <link rel="canonical" href="<%= canonicalUrl %>" />
    <%- include('partials/seo-social', {
      ogTitle: pageTitle + ' — Influzer.ai',
      ogDescription: metaDescription,
      ogUrl: canonicalUrl,
    }) %>
    <%- include('partials/favicon-links') %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/home.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/css/mcp-setup-page.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/css/mcp-scoreboard.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/css/mcp-sponsor.css?v=<%= assetVersion %>" />
  </head>
  <body class="registry-page">
    <%- include('partials/home-header') %>

    <main class="setup-shell" id="main">
      <a class="setup-back" href="/mcp/scoreboard">← Handshake scoreboard</a>
      <p class="setup-eyebrow">Sponsored placement · not a SAFE badge</p>
      <h1 class="setup-title">Promote an MCP server</h1>
      <p class="setup-lead">
        Two labeled slots, <b>$<%= offer.product.price_usd %></b> / month each.
        You sit at the top of the homepage, the directory, and the handshake scoreboard.
        Sold out that is <b>$<%= offer.monthly_if_sold_out_usd %></b> / month — enough to run the directory.
        You buy traffic and a Sponsored label. You do not buy <code>live_ok</code>.
      </p>

      <% if (paid) { %>
        <p class="promote-flash promote-flash--ok">Payment received. We place the labeled cards on the next cycle (subject to the <a href="/mcp/promote/terms">Sponsored Placement Terms</a>) and email <code>hello@influzer.ai</code> confirmation.</p>
      <% } %>
      <% if (canceled) { %>
        <p class="promote-flash">Checkout canceled. The slot is still open if you want it.</p>
      <% } %>

      <section class="promote-where" aria-label="Where you appear">
        <h2>Where you appear</h2>
        <p class="promote-where__lead">This is the product: labeled, on top, on the pages people already use to pick a server.</p>
        <ol>
          <% offer.placements.forEach(function(place) { %>
            <li>
              <b><%= place.label %></b>
              <span><%= place.where %></span>
            </li>
          <% }); %>
        </ol>
      </section>

      <%- include('partials/mcp-sponsor-rail') %>

      <section class="promote-terms-block promote-terms-block--ban" aria-label="Advertising rules">
        <h2>Advertising rules</h2>
        <p class="promote-where__lead">
          No porn, gambling, scams, malware, hate, or illegal offers.
          If a placement breaks the rules, we can remove it and <b>keep the fee</b>.
          Full text:
          <a href="<%= offer.terms_path || '/mcp/promote/terms' %>">Sponsored Placement Terms</a>
          (v<%= offer.terms_version %>).
        </p>
        <ul class="promote-ban-list promote-ban-list--compact">
          <% (offer.terms && offer.terms.prohibited ? offer.terms.prohibited : []).slice(0, 6).forEach(function(item) { %>
            <li>
              <b><%= item.label %></b>
              <span><%= item.detail %></span>
            </li>
          <% }); %>
        </ul>
      </section>

      <div class="promote-grid">
        <section class="promote-card">
          <h2>What you get</h2>
          <ul>
            <% offer.includes.forEach(function(item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
          <h2>What you do not get</h2>
          <ul>
            <% offer.excludes.forEach(function(item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
          <p class="promote-stock">
            <% if (offer.sold_out) { %>
              Both slots are taken. Email <a href="mailto:<%= offer.contact %>?subject=Sponsored%20placement%20waitlist"><%= offer.contact %></a> for the waitlist.
            <% } else { %>
              <b><%= offer.remaining %></b> of <%= offer.product.max_concurrent %> labeled slots open.
            <% } %>
          </p>
        </section>

        <form class="promote-form" id="promoteForm" <%= offer.sold_out ? 'hidden' : '' %>>
          <label>
            Work email
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label>
            Company
            <input type="text" name="company" maxlength="120" />
          </label>
          <label>
            Influzer slug (optional)
            <input type="text" name="slug" placeholder="asana" autocomplete="off" />
          </label>
          <label>
            HTTPS MCP URL (if no slug)
            <input type="url" name="url" placeholder="https://mcp.example.com/mcp" />
          </label>
          <label>
            Note
            <textarea name="note" rows="3" maxlength="500" placeholder="Dates, listing to pin, invoice needs"></textarea>
          </label>
          <label class="promote-accept">
            <input type="checkbox" name="accept_terms" value="1" required />
            <span>
              I agree to the
              <a href="<%= offer.terms_path || '/mcp/promote/terms' %>" target="_blank" rel="noopener noreferrer">Sponsored Placement Terms</a>
              (no porn, gambling, scams, malware, hate, or illegal ads; Influzer may remove violating ads and keep fees already paid).
            </span>
          </label>
          <input type="text" name="website" class="promote-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit" class="probe-form__submit" id="promoteSubmit">Subscribe $<%= offer.product.price_usd %>/month · labeled top placement</button>
          <p class="setup-note" id="promoteStatus">Stripe Checkout when configured. Otherwise we invoice <%= offer.contact %>.</p>
        </form>
      </div>
    </main>

    <%- include('partials/registry-footer') %>
    <script src="/js/registry.js?v=<%= assetVersion %>" defer></script>
    <script src="/js/mcp-promote.js?v=<%= assetVersion %>" defer></script>
  </body>
</html>
