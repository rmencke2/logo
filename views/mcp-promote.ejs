<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <title><%= pageTitle %> — Influzer.ai</title>
    <meta name="description" content="<%= metaDescription %>" />
    <link rel="canonical" href="<%= canonicalUrl %>" />
    <%- include('partials/seo-social', {
      ogTitle: pageTitle + ' — Influzer.ai',
      ogDescription: metaDescription,
      ogUrl: canonicalUrl,
    }) %>
    <%- include('partials/favicon-links') %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/home.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/css/mcp-setup-page.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/css/mcp-scoreboard.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/css/mcp-sponsor.css?v=<%= assetVersion %>" />
  </head>
  <body class="registry-page">
    <%- include('partials/home-header') %>

    <main class="setup-shell" id="main">
      <a class="setup-back" href="/mcp/scoreboard">← Handshake scoreboard</a>
      <p class="setup-eyebrow">Sponsored placement · not a SAFE badge</p>
      <h1 class="setup-title">Promote an MCP server</h1>
      <p class="setup-lead">
        Two labeled slots, <b>$<%= offer.product.price_usd %></b> / month each.
        You sit at the top of the homepage, the directory, and the handshake scoreboard.
        Sold out that is <b>$<%= offer.monthly_if_sold_out_usd %></b> / month — enough to run the directory.
        You buy traffic and a Sponsored label. You do not buy <code>live_ok</code>.
      </p>
      <p class="setup-lead promote-kit-jump">
        <a href="#media-kit">Media kit</a>
        · <a href="#prospect-pack">Outbound prospect pack</a>
        · <a href="#promoteForm">Checkout</a>
      </p>

      <% if (paid) { %>
        <p class="promote-flash promote-flash--ok">Payment received. We place the labeled cards on the next cycle (subject to the <a href="/mcp/promote/terms">Sponsored Placement Terms</a>) and email <code>hello@influzer.ai</code> confirmation.</p>
      <% } %>
      <% if (canceled) { %>
        <p class="promote-flash">Checkout canceled. The slot is still open if you want it.</p>
      <% } %>

      <% const kit = typeof mediaKit !== 'undefined' && mediaKit ? mediaKit : (offer.media_kit || null); %>
      <% if (kit && kit.audience) { %>
        <section class="promote-kit" id="media-kit" aria-label="Sponsor media kit">
          <div class="promote-kit__head">
            <h2>Sponsor media kit</h2>
            <p class="promote-where__lead">
              <%= kit.pitch && kit.pitch.headline ? kit.pitch.headline : 'Reach MCP builders where they pick a server' %>.
              Numbers as of <b><%= kit.as_of || 'latest pull' %></b>.
              API: <a href="/api/v1/promote/media-kit"><code>/api/v1/promote/media-kit</code></a>
            </p>
          </div>
          <div class="promote-kit__stats" role="list">
            <div class="promote-kit__stat" role="listitem">
              <b><%= Number(kit.audience.human_uv_7d).toLocaleString() %></b>
              <span>Human unique visitors · 7d</span>
            </div>
            <div class="promote-kit__stat" role="listitem">
              <b><%= Number(kit.audience.human_pv_7d).toLocaleString() %></b>
              <span>Human pageviews · 7d</span>
            </div>
            <div class="promote-kit__stat" role="listitem">
              <b><%= kit.audience.typical_human_uv_per_day %></b>
              <span>Typical human UV / day</span>
            </div>
            <div class="promote-kit__stat" role="listitem">
              <b><%= kit.live.live_ok %></b>
              <span>Top 100 · live_ok now</span>
            </div>
          </div>
          <p class="promote-kit__note"><%= kit.audience.note %> <%= kit.methodology %></p>
          <div class="promote-kit__cols">
            <div>
              <h3>Where the ad sits</h3>
              <ol class="promote-kit__placements">
                <% (kit.placements || offer.placements).forEach(function(place) { %>
                  <li>
                    <b><%= place.label %></b>
                    <span><%= place.where %></span>
                    <% if (place.see_live) { %>
                      <a href="<%= place.see_live %>">See live →</a>
                    <% } %>
                  </li>
                <% }); %>
              </ol>
            </div>
            <div>
              <h3>Intent surfaces</h3>
              <ul class="promote-kit__surfaces">
                <% (kit.intent_surfaces || []).forEach(function(s) { %>
                  <li>
                    <a href="<%= s.path %>"><code><%= s.path %></code></a>
                    <span><%= s.why %></span>
                  </li>
                <% }); %>
              </ul>
              <p class="promote-kit__scarcity">
                <% if (offer.sold_out) { %>
                  Both slots taken this month · email <a href="mailto:<%= offer.contact %>"><%= offer.contact %></a> for waitlist
                <% } else { %>
                  <b><%= offer.remaining %></b> of <%= offer.product.max_concurrent %> slots open · $<%= offer.product.price_usd %>/mo · sold out = $<%= offer.monthly_if_sold_out_usd %>/mo
                <% } %>
              </p>
            </div>
          </div>
        </section>
      <% } else { %>
        <section class="promote-where" aria-label="Where you appear">
          <h2>Where you appear</h2>
          <p class="promote-where__lead">This is the product: labeled, on top, on the pages people already use to pick a server.</p>
          <ol>
            <% offer.placements.forEach(function(place) { %>
              <li>
                <b><%= place.label %></b>
                <span><%= place.where %></span>
              </li>
            <% }); %>
          </ol>
        </section>
      <% } %>

      <%- include('partials/mcp-sponsor-rail') %>

      <% const pack = typeof prospects !== 'undefined' && prospects ? prospects : (offer.prospects || null); %>
      <% if (pack && pack.items && pack.items.length) { %>
        <section class="promote-prospects" id="prospect-pack" aria-label="Outbound prospect pack">
          <div class="promote-prospects__head">
            <div>
              <h2>Outbound prospect pack</h2>
              <p class="promote-where__lead">
                Public Top 100 handshake pull — <b><%= pack.total %></b> servers with <code>live_ok</code> or <code>auth_required</code> and a fixed HTTPS host.
                Copy for outreach. Same facts as the <a href="/mcp/scoreboard">scoreboard</a>.
              </p>
            </div>
            <button type="button" class="promote-prospects__copy" id="prospectsCopy">
              Copy TSV
            </button>
          </div>
          <textarea id="prospectsTsv" class="promote-prospects__tsv" readonly hidden aria-hidden="true"><%= offer.prospects_tsv || '' %></textarea>
          <div class="promote-prospects__table-wrap">
            <table class="promote-prospects__table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Server</th>
                  <th>Status</th>
                  <th>Host</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% pack.items.forEach(function(row) { %>
                  <tr<%= row.sponsored ? ' class="is-sponsored"' : '' %>>
                    <td><%= row.rank %></td>
                    <td>
                      <a href="<%= row.page_url %>"><%= row.name %></a>
                      <code><%= row.slug %></code>
                    </td>
                    <td><%= row.live_status_label %></td>
                    <td><code><%= row.host_label %></code></td>
                    <td><a href="<%= row.promote_url %>"><%= row.sponsored ? 'Sponsored' : 'Promote' %></a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <p class="promote-kit__note" id="prospectsCopyStatus"><%= pack.note %></p>
        </section>
      <% } %>

      <section class="promote-terms-block promote-terms-block--ban" aria-label="Advertising rules">
        <h2>Advertising rules</h2>
        <p class="promote-where__lead">
          No porn, gambling, scams, malware, hate, or illegal offers.
          If a placement breaks the rules, we can remove it and <b>keep the fee</b>.
          Full text:
          <a href="<%= offer.terms_path || '/mcp/promote/terms' %>">Sponsored Placement Terms</a>
          (v<%= offer.terms_version %>).
        </p>
        <ul class="promote-ban-list promote-ban-list--compact">
          <% (offer.terms && offer.terms.prohibited ? offer.terms.prohibited : []).slice(0, 6).forEach(function(item) { %>
            <li>
              <b><%= item.label %></b>
              <span><%= item.detail %></span>
            </li>
          <% }); %>
        </ul>
      </section>

      <div class="promote-grid">
        <section class="promote-card">
          <h2>What you get</h2>
          <ul>
            <% offer.includes.forEach(function(item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
          <h2>What you do not get</h2>
          <ul>
            <% offer.excludes.forEach(function(item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
          <p class="promote-stock">
            <% if (offer.sold_out) { %>
              Both slots are taken. Email <a href="mailto:<%= offer.contact %>?subject=Sponsored%20placement%20waitlist"><%= offer.contact %></a> for the waitlist.
            <% } else { %>
              <b><%= offer.remaining %></b> of <%= offer.product.max_concurrent %> labeled slots open.
            <% } %>
          </p>
        </section>

        <form class="promote-form" id="promoteForm" <%= offer.sold_out ? 'hidden' : '' %>>
          <label>
            Work email
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label>
            Company
            <input type="text" name="company" maxlength="120" />
          </label>
          <label>
            Influzer slug (optional)
            <input type="text" name="slug" placeholder="asana" autocomplete="off" value="<%= typeof presetSlug !== 'undefined' && presetSlug ? presetSlug : '' %>" />
          </label>
          <label>
            HTTPS MCP URL (if no slug)
            <input type="url" name="url" placeholder="https://mcp.example.com/mcp" />
          </label>
          <label>
            Note
            <textarea name="note" rows="3" maxlength="500" placeholder="Dates, listing to pin, invoice needs"></textarea>
          </label>
          <label class="promote-accept">
            <input type="checkbox" name="accept_terms" value="1" required />
            <span>
              I agree to the
              <a href="<%= offer.terms_path || '/mcp/promote/terms' %>" target="_blank" rel="noopener noreferrer">Sponsored Placement Terms</a>
              (no porn, gambling, scams, malware, hate, or illegal ads; Influzer may remove violating ads and keep fees already paid).
            </span>
          </label>
          <input type="text" name="website" class="promote-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit" class="probe-form__submit" id="promoteSubmit">Subscribe $<%= offer.product.price_usd %>/month · labeled top placement</button>
          <p class="setup-note" id="promoteStatus">Stripe Checkout when configured. Otherwise we invoice <%= offer.contact %>.</p>
        </form>
      </div>
    </main>

    <%- include('partials/registry-footer') %>
    <script src="/js/registry.js?v=<%= assetVersion %>" defer></script>
    <script src="/js/mcp-promote.js?v=<%= assetVersion %>" defer></script>
  </body>
</html>
