<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <meta name="description" content="<%= description %>" />
    <link rel="canonical" href="<%= canonicalUrl %>" />
    <%- include('partials/seo-social', { ogTitle: title, ogDescription: description, ogUrl: canonicalUrl }) %>
    <%- include('partials/favicon-links') %>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/home.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/css/webmcp-directory.css?v=<%= assetVersion %>" />
  </head>
  <body class="registry-page webmcp-page">
    <%- include('partials/home-header') %>
    <main class="dir-shell webmcp-demo" style="padding:2rem 1rem 3rem;">
      <p class="webmcp-note">
        <a href="/webmcp">← WebMCP Directory</a>
        · <a href="/webmcp/setup">Setup &amp; launch guide</a>
      </p>

      <header class="webmcp-demo__hero">
        <p class="dir-hero__eyebrow">Live showcase · YouTube-ready</p>
        <h1>Influzer.ai WebMCP demo</h1>
        <p class="webmcp-prose">
          This page registers real <code>document.modelContext</code> tools for Influzer’s directories.
          Use the <strong>video tour</strong> for a narrated walkthrough, or the console below to call tools yourself.
        </p>
        <div class="webmcp-metrics">
          <span>Status: <b id="webmcp-demo-status" data-state="warn">Starting…</b></span>
          <span>Mode: <b id="webmcp-demo-mode">Detecting…</b></span>
        </div>
        <div class="webmcp-cta-row">
          <button type="button" class="webmcp-btn webmcp-btn--primary" id="webmcp-tour-start">Start video tour</button>
          <a class="webmcp-btn webmcp-btn--ghost" href="/webmcp/setup">How to set it up</a>
          <a class="webmcp-btn webmcp-btn--ghost" href="https://github.com/webmachinelearning/webmcp" rel="noopener noreferrer">WebMCP standard</a>
          <a class="webmcp-btn webmcp-btn--ghost" href="/api/webmcp/v1/self">Tool manifest JSON</a>
        </div>
      </header>

      <section class="webmcp-tour" id="webmcp-tour" aria-labelledby="webmcp-tour-heading" hidden>
        <div class="webmcp-tour__stage">
          <p class="webmcp-tour__kicker" id="webmcp-tour-kicker">Scene 1 of 5</p>
          <h2 id="webmcp-tour-heading">Detect WebMCP</h2>
          <p class="webmcp-tour__say" id="webmcp-tour-say">Narration appears here.</p>
          <p class="webmcp-tour__do" id="webmcp-tour-do">Action appears here.</p>
          <div class="webmcp-tour__progress" aria-hidden="true">
            <span id="webmcp-tour-bar"></span>
          </div>
          <div class="webmcp-cta-row">
            <button type="button" class="webmcp-btn webmcp-btn--primary" id="webmcp-tour-next">Run this scene</button>
            <button type="button" class="webmcp-btn webmcp-btn--ghost" id="webmcp-tour-skip">Skip</button>
            <button type="button" class="webmcp-btn webmcp-btn--ghost" id="webmcp-tour-stop">Stop tour</button>
          </div>
        </div>
        <pre class="webmcp-code webmcp-tour__output" id="webmcp-tour-output">Tour output appears here.</pre>
      </section>

      <section class="webmcp-demo__panel" aria-labelledby="demo-console-heading">
        <div class="webmcp-demo__controls">
          <h2 id="demo-console-heading">Tool console</h2>
          <p class="webmcp-note">Uses <code>getTools()</code> and <code>executeTool()</code> — the same discovery path in-page agents use.</p>

          <label>
            Tool
            <select id="webmcp-demo-tool"></select>
          </label>

          <div class="webmcp-demo__presets" id="webmcp-demo-presets">
            <button type="button" class="webmcp-btn webmcp-btn--ghost" data-preset="get_influzer_overview">Preset: overview</button>
            <button type="button" class="webmcp-btn webmcp-btn--ghost" data-preset="search_webmcp_sites">Preset: search sites</button>
            <button type="button" class="webmcp-btn webmcp-btn--ghost" data-preset="search_mcp_servers">Preset: search MCP</button>
            <button type="button" class="webmcp-btn webmcp-btn--ghost" data-preset="get_best_mcp_client">Preset: best for Claude</button>
            <button type="button" class="webmcp-btn webmcp-btn--ghost" data-preset="get_mcp_server">Preset: get playwright</button>
          </div>

          <label>
            Arguments (JSON)
            <textarea id="webmcp-demo-args" rows="8" spellcheck="false">{}</textarea>
          </label>

          <div class="webmcp-cta-row">
            <button type="button" class="webmcp-btn webmcp-btn--primary" id="webmcp-demo-run">Run executeTool()</button>
            <button type="button" class="webmcp-btn webmcp-btn--ghost" id="webmcp-demo-refresh">Refresh getTools()</button>
          </div>
        </div>

        <div class="webmcp-demo__results">
          <h3>Input schema</h3>
          <pre class="webmcp-code" id="webmcp-demo-schema">{}</pre>
          <h3>Result</h3>
          <pre class="webmcp-code" id="webmcp-demo-output">Run a tool to see structured output.</pre>
          <h3>Log</h3>
          <pre class="webmcp-code webmcp-demo__log" id="webmcp-demo-log"></pre>
        </div>
      </section>

      <section class="webmcp-demo__howto webmcp-prose">
        <h2>How to try this yourself</h2>
        <ol>
          <li>Click <strong>Start video tour</strong> for a narrated 5-scene walkthrough (ideal for screen recording).</li>
          <li>Or pick a tool, edit JSON args, click <strong>Run executeTool()</strong>.</li>
          <li>From DevTools: <code>await document.modelContext.getTools()</code> then <code>await document.modelContext.executeTool(tools[0], {})</code>.</li>
          <li>Full launch checklist: <a href="/webmcp/setup">Set up and launch WebMCP</a>.</li>
        </ol>
        <h2>Registered tools</h2>
        <ul>
          <% tools.forEach(function(t) { %>
            <li><code><%= t.name %></code> — <%= t.description %></li>
          <% }) %>
        </ul>
      </section>
    </main>
    <%- include('partials/registry-footer') %>
    <%- include('partials/influzer-webmcp-script') %>
    <script src="/js/influzer-webmcp-demo.js?v=<%= assetVersion %>" defer></script>
  </body>
</html>
