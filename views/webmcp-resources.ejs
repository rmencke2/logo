<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <meta name="description" content="<%= description %>" />
    <link rel="canonical" href="<%= canonicalUrl %>" />
    <%- include('partials/seo-social', { ogTitle: title, ogDescription: description, ogUrl: canonicalUrl }) %>
    <%- include('partials/favicon-links') %>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/home.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/css/webmcp-directory.css?v=<%= assetVersion %>" />
  </head>
  <body class="registry-page webmcp-page">
    <%- include('partials/home-header') %>
    <main class="dir-shell" style="padding:2rem 1rem;">
      <p class="webmcp-note"><a href="/webmcp">← WebMCP Directory</a></p>
      <h1>WebMCP resources</h1>
      <div class="webmcp-grid">
        <% resources.forEach(function(r) { %>
          <a class="webmcp-card" href="<%= r.canonical_url %>" rel="noopener noreferrer" target="_blank">
            <div class="webmcp-badges"><span class="webmcp-badge"><%= r.resource_type %></span></div>
            <h2 class="webmcp-card__name"><%= r.title %></h2>
            <p class="webmcp-card__desc"><%= r.description %></p>
            <p class="webmcp-note"><%= r.owner_name %> · checked <%= r.checked_at %></p>
          </a>
        <% }) %>
      </div>
    </main>
    <%- include('partials/registry-footer') %>
    <script src="/js/site-auth.js?v=<%= assetVersion %>" defer></script>
  </body>
</html>
