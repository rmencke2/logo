<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <title><%= seo.pageTitle %></title>
    <meta name="description" content="<%= seo.metaDescription %>" />
    <meta name="keywords" content="<%= seo.metaKeywords %>" />
    <meta name="author" content="Influzer.ai" />
    <link rel="canonical" href="https://www.influzer.ai/" />
    <link rel="alternate" type="application/rss+xml" title="Influzer.ai Insights" href="https://www.influzer.ai/insights/rss.xml" />
    <%- include('partials/favicon-links') %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/home.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/css/mcp-sponsor.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/css/mcp-milestone.css?v=<%= assetVersion %>" />
    <%- include('partials/seo-social', {
      ogTitle: seo.pageTitle,
      ogDescription: seo.metaDescription,
      ogUrl: 'https://www.influzer.ai/',
      ogImage: seo.ogImage,
      ogImageAlt: featuredPost ? featuredPost.coverImageAlt : 'Influzer.ai MCP directory and AI insights',
    }) %>
    <script type="application/ld+json">
      <%- JSON.stringify(jsonLd) %>
    </script>
  </head>
  <body class="home-page">
    <a class="skip-link" href="#main">Skip to main content</a>
    <%- include('partials/home-header') %>
    <%- include('partials/mcp-milestone-banner') %>

    <header class="home-hero">
      <div class="home-hero__inner">
        <p class="home-hero__eyebrow">The MCP server registry</p>
        <h1 class="home-hero__title">Find the right MCP server<br />for your AI stack</h1>
        <form class="home-hero__search" id="homeHeroSearch" action="/mcp" method="get" role="search">
          <label class="visually-hidden" for="homeMcpSearch" style="position:absolute;left:-9999px;">Search MCP servers</label>
          <input
            id="homeMcpSearch"
            type="search"
            name="q"
            placeholder='Search by tool — "postgres", "browser automation", "scrape URLs"…'
            autocomplete="off"
            enterkeyhint="search"
          />
          <button type="submit">Search</button>
        </form>
        <div class="home-hero__chips" role="list">
          <% categories.forEach(function(cat) { %>
            <button type="button" class="home-hero__chip" data-query="<%= cat %>" role="listitem"><%= cat %></button>
          <% }); %>
        </div>
        <div class="home-hero__stats" aria-label="Directory statistics">
          <span><b id="homeServerCount" data-target="<%= heroStats.totalServers %>"><%= heroStats.totalServers.toLocaleString() %></b> servers</span>
          <span><b><%= toolCountDisplay %></b> indexed tools</span>
          <span><b><%= heroStats.categoryCount %></b> categories</span>
          <span><b>weekly</b> updates</span>
        </div>
        <p class="home-hero__embed">
          Search the catalog here — or drop Influzer into the agent, CI, and docs.
          <a href="#embed">Embed tools →</a>
          · <a href="/mcp/scoreboard">Handshake scoreboard →</a>
        </p>
        <div class="home-hero__indexing">
          <span>Indexing</span>
          <div class="home-hero__indexing-list">
            <% indexingServers.forEach(function(name) { %>
              <span class="home-hero__index-chip"><%= name %></span>
            <% }); %>
            <span class="home-hero__index-chip home-hero__index-chip--more">+<%= indexingMore.toLocaleString() %></span>
          </div>
        </div>
      </div>
    </header>

    <section class="home-sponsors" aria-label="Sponsored placements">
      <%- include('partials/mcp-sponsor-rail') %>
    </section>

    <section class="home-board" id="scoreboard" aria-labelledby="homeBoardHeading">
      <div class="home-board__inner">
        <div class="home-board__copy">
          <p class="home-board__eyebrow">No VC · No tracking · No pay-to-rank</p>
          <h2 class="home-board__title" id="homeBoardHeading">Influzer is run by one person and funded by its sponsors.</h2>
        </div>
        <div class="home-board__fund">
          <p class="home-board__lead">
            Every handshake, crawl, and index rebuild costs money. Two sponsor slots a month keep the registry free — and never touch the ranking.
          </p>
          <div class="home-board__meter" aria-label="Sponsor funding this month">
            <div class="home-board__meter-labels">
              <span>This month · $<%= promoteOffer.funded_usd %> funded</span>
              <span>Goal $<%= promoteOffer.monthly_if_sold_out_usd %></span>
            </div>
            <div class="home-board__bar" role="progressbar" aria-valuemin="0" aria-valuemax="<%= promoteOffer.monthly_if_sold_out_usd %>" aria-valuenow="<%= promoteOffer.funded_usd %>">
              <span style="width: <%= Math.max(promoteOffer.funded_pct, promoteOffer.funded_usd ? 8 : 0) %>%"></span>
            </div>
          </div>
          <div class="home-board__actions">
            <a class="home-board__btn home-board__btn--primary" href="/mcp/promote">Promote your server · $<%= promoteOffer.product.price_usd %></a>
            <a class="home-board__btn home-board__btn--ghost" href="/mcp/promote">How slots work</a>
          </div>
          <p class="home-board__clock">
            Top 100 handshake:
            <a href="/mcp/scoreboard"><b><%= scoreboard.counts.live_ok %></b> live</a>
            · <b><%= scoreboard.counts.auth_required %></b> auth
            · <b><%= scoreboard.https_hosts %></b> HTTPS hosts
          </p>
        </div>
      </div>
    </section>

    <section class="home-tools" id="embed" aria-labelledby="homeToolsHeading">
      <div class="home-tools__inner">
        <div class="home-tools__head">
          <h2 class="home-tools__title" id="homeToolsHeading">Put Influzer in the workflow</h2>
          <p class="home-tools__lead">
            Search, handshake, paste, teach the agent — or watch the Top 100 clock.
            None of them is a safe-to-install badge.
          </p>
        </div>
        <div class="home-tools__grid">
          <a class="home-tool" href="/mcp/discovery/setup">
            <span class="home-tool__kicker">MCP</span>
            <span class="home-tool__name">Discovery</span>
            <span class="home-tool__desc">Read-only server. Search the catalog from Cursor, Claude, or ChatGPT — no auth.</span>
            <code class="home-tool__code">/mcp/discovery</code>
          </a>
          <a class="home-tool" href="/mcp/influzer-mcp-discovery#install">
            <span class="home-tool__kicker">Snippets</span>
            <span class="home-tool__name">Install JSON</span>
            <span class="home-tool__desc">Cursor, Claude, ChatGPT, Claude Code, ACP. Embed the widget on any docs page.</span>
            <code class="home-tool__code">/api/v1/install/:slug</code>
          </a>
          <a class="home-tool" href="/mcp/probe">
            <span class="home-tool__kicker">API</span>
            <span class="home-tool__name">Handshake probe</span>
            <span class="home-tool__desc">Live <code>tools/list</code> for an HTTPS URL. CI on mcp.json, or a README SVG badge.</span>
            <code class="home-tool__code">/api/v1/probe/badge</code>
          </a>
          <a class="home-tool" href="/mcp/discovery/skill">
            <span class="home-tool__kicker">Skill</span>
            <span class="home-tool__name">Search → paste</span>
            <span class="home-tool__desc">SKILL.md so the agent searches, handshakes, then pastes — it does not auto-connect.</span>
            <code class="home-tool__code">/skills/influzer-mcp/SKILL.md</code>
          </a>
          <a class="home-tool" href="/mcp/scoreboard">
            <span class="home-tool__kicker">Live</span>
            <span class="home-tool__name">Scoreboard</span>
            <span class="home-tool__desc">Top 100 × last handshake. Sponsored pins are ads — they do not buy live_ok.</span>
            <code class="home-tool__code">/mcp/scoreboard</code>
          </a>
        </div>
      </div>
    </section>

    <main class="home-main" id="main">
      <div class="home-col">
        <section class="home-section" aria-labelledby="homeServersHeading">
          <div class="home-section__head">
            <h2 class="home-section__title" id="homeServersHeading">Top servers this week</h2>
            <a class="home-section__link" href="/mcp">Browse all <%= heroStats.totalServers.toLocaleString() %> →</a>
          </div>
          <div class="home-server-list" id="homeServerList">
            <% topServers.forEach(function(server) { %>
              <a
                class="home-server-row"
                href="/mcp/<%= server.slug %>"
                data-search="<%= server.searchText %>"
              >
                <span class="home-server-row__icon<%= server.official ? ' home-server-row__icon--official' : '' %>" aria-hidden="true"><%= server.initial %></span>
                <div class="home-server-row__body">
                  <div class="home-server-row__name">
                    <%= server.name %>
                    <% if (server.official) { %><span class="home-server-row__official">OFFICIAL</span><% } %>
                    <% if (server.handshake_svg) { %>
                      <span class="mcp-handshake-badge" title="MCP handshake — not a SAFE badge"><%- server.handshake_svg %></span>
                    <% } %>
                  </div>
                  <div class="home-server-row__desc"><%= server.shortDesc %></div>
                </div>
                <div class="home-server-row__meta">
                  <div class="home-server-row__kind"><%= server.kind %></div>
                  <div class="home-server-row__cat"><%= server.category %></div>
                </div>
              </a>
            <% }); %>
            <div class="home-server-empty" id="homeServerEmpty" role="status">
              No servers match “<span id="homeEmptyQuery"></span>” in this preview — the live directory searches all <%= toolCountDisplay %> indexed tools. <a href="/mcp">Browse all →</a>
            </div>
          </div>
        </section>

        <% if (insightPosts && insightPosts.length) { %>
          <section class="home-section" aria-labelledby="homeInsightsHeading">
            <div class="home-section__head">
              <h2 class="home-section__title" id="homeInsightsHeading">
                Latest from Insights
                <span class="home-badge">ORIGINAL</span>
              </h2>
              <a class="home-section__link" href="/insights">All articles →</a>
            </div>
            <div class="home-insights-grid">
              <% insightPosts.forEach(function(post) { %>
                <a class="home-insight-card" href="/insights/<%= post.slug %>">
                  <% if (post.coverImage) { %>
                    <img
                      class="home-insight-card__media"
                      src="<%= post.coverImage %>"
                      alt="<%= post.coverImageAlt %>"
                      width="320"
                      height="110"
                      loading="lazy"
                    />
                  <% } else { %>
                    <div class="home-insight-card__media" aria-hidden="true"></div>
                  <% } %>
                  <div class="home-insight-card__body">
                    <div class="home-insight-card__title"><%= post.title %></div>
                    <div class="home-insight-card__meta"><%= post.dateShort || post.dateDisplay %> · <%= post.readMinutes %> min read</div>
                  </div>
                </a>
              <% }); %>
            </div>
          </section>
        <% } %>

        <% if (otherNews && otherNews.articles && otherNews.articles.length) { %>
          <section class="home-section home-around" aria-labelledby="homeAroundHeading">
            <div class="home-around__head">
              <h2 class="home-section__title home-section__title--sm" id="homeAroundHeading">Around the web</h2>
              <span class="home-section__note">community posts &amp; press — updated daily</span>
            </div>
            <div>
              <% otherNews.articles.forEach(function(article) { %>
                <a class="home-around__row" href="<%= article.outbound_url %>" target="_blank" rel="noopener noreferrer">
                  <span class="home-around__source"><%= article.sourceTag %></span>
                  <span><%= article.title %></span>
                </a>
              <% }); %>
              <div class="home-around__more">
                <a href="/news">All briefs →</a>
              </div>
            </div>
          </section>
        <% } %>
      </div>

      <aside class="home-aside">
        <%- include('partials/registry-newsletter', { newsletterSource: 'home-newsletter-card', newsletterId: 'newsletter' }) %>

        <div class="home-aside-card">
          <h3 class="home-aside-card__title">Search from inside your agent</h3>
          <p class="home-aside-card__desc"><%= discoveryPromo && discoveryPromo.promoBlurb ? discoveryPromo.promoBlurb : 'Our official MCP server works in Claude, Cursor & ChatGPT. No auth required.' %></p>
          <div class="home-aside-card__code">influzer.ai/mcp/discovery</div>
          <a class="home-aside-card__btn" href="<%= discoveryPromo && discoveryPromo.setupUrl ? discoveryPromo.setupUrl : '/mcp/discovery/setup' %>">Connect in 2 minutes</a>
          <p class="home-aside-card__desc" style="margin-top:12px;margin-bottom:0;">
            <a href="/mcp/discovery/skill">Agent skill</a>
            · <a href="/mcp/influzer-mcp-discovery#install">Snippets</a>
            · <a href="/mcp/probe">Probe</a>
            · <a href="/mcp/scoreboard">Scoreboard</a>
            · <a href="/mcp/promote">Promote</a>
            · <a href="<%= discoveryPromo && discoveryPromo.startersUrl ? discoveryPromo.startersUrl : '/mcp/discovery/starters' %>">Starters</a>
          </p>
        </div>

        <div class="home-aside-card">
          <h3 class="home-aside-card__title">Built an MCP server?</h3>
          <p class="home-aside-card__desc">Get listed and reach teams choosing their production stack.</p>
          <a class="home-aside-card__btn" href="/mcp/submit">Submit a server</a>
        </div>
      </aside>
    </main>

    <%- include('partials/registry-footer', { showFooterLang: true }) %>

    <script>
      window.__HOME_HERO__ = {
        toolCountDisplay: <%- JSON.stringify(toolCountDisplay) %>,
        totalServers: <%= heroStats.totalServers %>
      };
    </script>
    <script src="/js/registry.js?v=<%= assetVersion %>" defer></script>
    <script src="/js/home.js?v=<%= assetVersion %>" defer></script>
    <script src="/js/home-newsletter.js?v=<%= assetVersion %>" defer></script>
    <%- include('partials/influzer-webmcp-script') %>
  </body>
</html>
