# Python
venv/
.venv/
__pycache__/
*.py[cod]

# Node
node_modules/
mcp-directory/

# Build artifacts - generated output files (user-generated content, not source code)
generated_*/
generated_img/
generated_video/

# Large media (often generated)
*.gif
*.mp4
*.avi
*.mov
*.webm
*.mkv
*.flv
*.3gp
*.wmv

# Editor / OS
.DS_Store
*.pem

# Env
.env
.env*.local
.deploy.env
.deploy-deps-hash
client_secret_*.json
*service-account*.json

# TypeScript
*.tsbuildinfo

# Migration tool venv
migration-tool/.venv/

# Docker
Dockerfile*
# Cloud Agent environment Dockerfile must be tracked
!.cursor/Dockerfile

# Database files
*.db
*.sqlite
*.sqlite3

# MCP submission form payloads (may contain emails and test credentials)
data/mcp-submissions/*.json

# OAuth clients registered while probing auth-gated MCP servers
data/mcp-probe-accounts.json
data/mcp-claims/*.json
data/mcp-promote-requests.json

# Runtime handshake overlay from boot warm-probe
data/mcp-handshake-warm.json

# Probe flips recorded on the server between deploys
data/mcp-handshake-diff.local.json

# Expo (mobile subproject)
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
app-example
/ios
/android

# WebMCP private submissions
data/webmcp-submissions/
