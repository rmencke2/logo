# Local Development Configuration
PORT=4000
NODE_ENV=development
BASE_URL=http://localhost:4000
SESSION_SECRET=local-dev-secret-change-in-production
DB_PATH=./logo_generator.db

# Optional — exact emails that bypass global rate limits (comma-separated). Admins always bypass.
# RATE_LIMIT_BYPASS_EMAILS=you@example.com

# Optional — Cloudflare Turnstile for blog comments (required in production)
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=

# Optional - Email (newsletter + transactional)
# Recommended for production: Resend (no Gmail Sent-folder flood, proper bulk sending)
# EMAIL_SERVICE=resend
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Influzer <noreply@influzer.ai>
# NEWSLETTER_FROM=Influzer Insights <insights@influzer.ai>
# NEWSLETTER_REPLY_TO=mencke@gmail.com

# Legacy Gmail (dev only — each recipient creates a copy in your Sent folder)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-gmail-app-password

# Optional - OAuth Providers (for Google/Facebook login)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=your-facebook-app-secret

# Optional - CORS (usually not needed for local dev)
# ALLOWED_ORIGINS=http://localhost:4000

# Optional - GA4 analytics report metrics
# GA4_PROPERTY_ID=123456789
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/ga4-service-account.json
# Or set service account JSON directly for hosted environments:
# GA4_CREDENTIALS_JSON={"type":"service_account",...}

# Optional - WebMCP directory discovery seed (server-side only)
# WEBMCP_DISCOVERY_BASE_URL=https://webmcp.com
# WEBMCP_DISCOVERY_TIMEOUT_MS=20000

# Optional — scoreboard pin Checkout (Influzer Promo $249/month, max 2 concurrent)
# Add these on the Lightsail server .env only — never commit live keys.
# Product ID (prod_…) is not used. Checkout needs the Price ID (price_…).
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PROMOTE_PRICE_ID=price_...
# STRIPE_PROMOTE_MODE=subscription
# STRIPE_PROMOTE_PAYMENT_LINK=https://buy.stripe.com/...
